# =============================================================================
# Downloaded / generated data (large, regeneratable via scripts/)
# =============================================================================
/data/
/vcfs/
/chunks/
/chunks*/
hs37d5.ref.genozip
*.ref.genozip

# Pipeline scratch / outputs
/out/
/out*/
/tmp/
/tmp.*/

# OpenZL checkout (generated by scripts/get_openzl.sh)
/openzl/

# Third-party tooling built/installed locally
/comp_env/
/bcftools-1.19/
/bcftools-*.tar.*
/genozip-linux-*/

# =============================================================================
# Compiled binaries (rebuilt by scripts/build_all.sh / scripts/build_harc.sh)
# =============================================================================
/tools/biocompress_preprocessor
/tools/bed_preprocess
/tools/fastq_preprocess
/tools/vcf_preprocessing
/tools/vcf_postprocess
/tools/vcf_field_codec
/tools/harc_preprocessor
/tools/vcf_gtcodec
/tools/harc_decode
*.o
core
core.*
*.core

# =============================================================================
# SLURM job logs (job-id suffixed) and profiler dumps
# =============================================================================
/*_[0-9][0-9][0-9]*.log
/*_[0-9][0-9][0-9]*.err
/*_[0-9][0-9][0-9]*.out
/slurm-*.out
/slurm-*.err
profiler_*.out
/results/*.err
/results/*.out
/results/slurm_*
/results/patch_*

# =============================================================================
# Generated compression artifacts / benchmark scratch
# =============================================================================
/artifacts/*.compressor
/artifacts/*.zl
/benchmark_results.txt
/results/benchmark_*_[0-9]*.csv
/results/benchmark_*_[0-9]*.txt

# Stray compressed test blobs
/*.gz
/*.zst
/*.xz
/*.7z
/*.bz2
/test_sample.vcf.*
/t.*

# =============================================================================
# NYX FASTQ codec — source lives in tools/nyx/, staged into openzl/ at build time
# =============================================================================
/openzl/nyx/
/openzl/nyxfqz
/openzl/nyxfqz_v2
/openzl/nyxfqz*.make

# =============================================================================
# OS / editor
# =============================================================================
.DS_Store
*.swp
*~
/tools/fasta_postprocess
/.build_all.lock
/data/vcf/corpus/
/out/
/data/fasta_train/

# =============================================================================
# Manuscript drafts (private — the folder is tracked, its contents are not)
# =============================================================================
/paper/*
!/paper/.gitkeep
!/paper/README.md
/docs/*.docx
