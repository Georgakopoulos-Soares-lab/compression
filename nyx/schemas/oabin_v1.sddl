U32 = UInt32LE
magic              : Byte[4]
version            : Byte[2]
reserved           : Byte[2]
n_records          : U32
n_strings          : U32
n_alts_total       : U32
n_cby_total        : U32
complex_blob_len   : U32
string_blob_len    : U32
works_count        : Byte[n_records * 4]
cited_by_count     : Byte[n_records * 4]
h_index            : Byte[n_records * 4]
i10_index          : Byte[n_records * 4]
mean_citedness     : Byte[n_records * 4]
id_refs            : U32[n_records]
display_name_refs  : U32[n_records]
works_api_url_refs : U32[n_records]
updated_date_refs  : U32[n_records]
created_date_refs  : U32[n_records]
alt_offsets        : U32[n_records + 1]
alt_refs           : U32[n_alts_total]
cby_offsets        : U32[n_records + 1]
cby_years          : Byte[n_cby_total * 4]
cby_works          : Byte[n_cby_total * 4]
cby_cited          : Byte[n_cby_total * 4]
complex_offsets    : U32[n_records + 1]
complex_blob       : Byte[complex_blob_len]
string_offsets     : U32[n_strings + 1]
string_blob        : Byte[string_blob_len]
: Byte[_rem]
