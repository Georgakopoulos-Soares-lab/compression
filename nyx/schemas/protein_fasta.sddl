U32 = UInt32LE

# NXFP: Protein FASTA Packed Binary
# Each chunk file is a self-contained binary with header, per-record
# metadata, and concatenated payload buffers for all encoded streams.
# Protein sequences are stored as raw uppercase bytes (1 byte per AA).

magic          : Byte[4]
version        : U32
num_records    : U32
newline_style  : UInt8
has_trailing   : UInt8
stream_flags   : UInt8
_reserved1     : Byte[1]
total_hdr      : U32
total_seq      : U32
total_case     : U32
total_wrap     : U32

# Per-record metadata (20 bytes each, matching ProteinRecordMeta struct)
ProteinRecordMeta = {
  seq_len      : U32
  hdr_len      : U32
  case_bytes   : U32
  wrap_bytes   : U32
  case_mode    : UInt8
  _pad         : Byte[3]
}

metadata       : ProteinRecordMeta[num_records]

# Payload buffers (sizes from global header)
hdr_data       : Byte[total_hdr]
seq_data       : Byte[total_seq]
case_data      : Byte[total_case]
wrap_data      : Byte[total_wrap]

: Byte[_rem]
