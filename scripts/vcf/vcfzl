#!/usr/bin/env bash
# vcfzl — archetype-dispatched VCF compression on top of OpenZL.
#
# --archetype <id> selects a pre-trained OpenZL compressor
# (artifacts/vcf_models/<id>.zlc) built by scripts/vcf/train_vcf_library.sh.
# Omit it (or pass --archetype auto) to auto-detect from the file. There is NO
# runtime training; an unknown or untrained archetype is a hard error.
#
#   vcfzl archetypes
#   vcfzl classify   <in.vcf>
#   vcfzl compress    [--archetype <id>|auto] [--threads N] [--verify] <in.vcf> <out.vcfz>
#   vcfzl decompress  [--threads N] <in.vcfz> <out.vcf>
#   vcfzl inspect     <in.vcfz>
#
# .vcfz layout (tar.gz):  manifest.json  archetype  header.vcf  zl/part_*.vcfbody.zl
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ZLI="${ZLI:-$HERE/openzl/zli}"
VCF_PRE="${VCF_PRE:-$HERE/tools/vcf_preprocessing}"
VCF_POST="${VCF_POST:-$HERE/tools/vcf_postprocess}"
COMPRESS_PARTS="${COMPRESS_PARTS:-$HERE/scripts/vcf/vcf_compress_parts.sh}"
VCF_GT="${VCF_GT:-$HERE/tools/vcf_gtcodec}"
MODEL_DIR="${VCFZL_MODEL_DIR:-$HERE/artifacts/vcf_models}"
REGISTRY="$MODEL_DIR/archetypes.tsv"
MAX_CHUNK_MIB="${VCFZL_MAX_CHUNK_MIB:-40}"

die() { echo "vcfzl: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

registry_ids() { grep -v '^#' "$REGISTRY" | awk -F'\t' 'NF{print $1}'; }
registry_desc() { grep -v '^#' "$REGISTRY" | awk -F'\t' -v id="$1" 'NF && $1==id {print $5}'; }
model_path()   { echo "$MODEL_DIR/$1.zlc"; }

require_tools() {
  [ -x "$ZLI" ]      || die "OpenZL zli not found at $ZLI (run scripts/build_all.sh)"
  [ -x "$VCF_PRE" ]  || die "vcf_preprocessing not built (run scripts/build_all.sh)"
  [ -x "$VCF_POST" ] || die "vcf_postprocess not built (run scripts/build_all.sh)"
  [ -x "$VCF_GT" ]   || die "vcf_gtcodec not built (run scripts/build_all.sh)"
  [ -f "$REGISTRY" ] || die "archetype registry missing: $REGISTRY"
}

VCFZ_VERSION="vcfz2"

# deterministic content hash of an unpacked stage dir
_checksum() {
  ( cd "$1" && { find zl -name '*.zl' | LC_ALL=C sort | tr '\n' '\0' | xargs -0 cat; cat header.vcf manifest.json; } \
      | sha256sum | cut -d' ' -f1 )
}

# unpack <in.vcfz> to <out.vcf>; verifies version + content checksum. No EXIT trap.
_vcfz_extract() {
  local in="$1" out="$2" threads="$3"
  local stage; stage="$(mktemp -d "${TMPDIR:-/tmp}/vcfzl.XXXXXX")"
  tar -C "$stage" -xzf "$in" 2>/dev/null || { rm -rf "$stage"; die "not a vcfzl archive: $in"; }
  { [ -f "$stage/manifest.json" ] && [ -f "$stage/header.vcf" ] && [ -d "$stage/zl" ]; } \
    || { rm -rf "$stage"; die "not a vcfzl archive: $in"; }
  if [ -f "$stage/FORMAT" ]; then
    [ "$(cat "$stage/FORMAT")" = "$VCFZ_VERSION" ] || { rm -rf "$stage"; die "unsupported vcfz version: $(cat "$stage/FORMAT")"; }
    local want got; want="$(cat "$stage/checksum" 2>/dev/null || true)"; got="$(_checksum "$stage")"
    [ -n "$want" ] && [ "$want" = "$got" ] || { rm -rf "$stage"; die "checksum mismatch — archive is corrupt"; }
  fi
  mkdir -p "$stage/body_parts"
  find "$stage/zl" -name '*.zl' -print0 \
    | xargs -0 -P "$threads" -I{} bash -c '
        f="$1"; b="$(basename "$f" .zl)"
        d="'"$stage"'/body_parts/${b}"
        "'"$ZLI"'" decompress "$f" --output "$d.raw" --force >/dev/null 2>&1 || exit 0
        if [ "$(head -c4 "$d.raw")" = "VGT1" ]; then
          "'"$VCF_GT"'" unpack "$d.raw" "$d.dec" >/dev/null 2>&1
        else
          mv -f "$d.raw" "$d.dec"
        fi
        rm -f "$d.raw"
      ' _ {}
  "$VCF_POST" "$stage" "$out" --threads "$threads" --chunk-suffix .dec >/dev/null 2>&1 \
    || { rm -rf "$stage"; die "reassembly failed — archive may be corrupt"; }
  VCFZ_ARCHETYPE="$(cat "$stage/archetype" 2>/dev/null || echo '?')"
  rm -rf "$stage"
}

# ---- archetypes -----------------------------------------------------------
cmd_archetypes() {
  [ -f "$REGISTRY" ] || die "registry missing: $REGISTRY"
  printf '%-16s  %-9s  %s\n' ARCHETYPE MODEL DESCRIPTION
  printf '%-16s  %-9s  %s\n' ---------------- --------- -----------
  while IFS=$'\t' read -r id rule src status desc; do
    [ -n "$id" ] || continue
    case "$id" in \#*) continue;; esac
    if [ -f "$(model_path "$id")" ]; then st="ready"; else st="MISSING"; fi
    printf '%-16s  %-9s  %s\n' "$id" "$st" "$desc"
  done < <(grep -v '^#' "$REGISTRY")
  echo
  echo "compress with:  vcfzl compress --archetype <ARCHETYPE> in.vcf out.vcfz"
}

# ---- classify (advisory only) ------------------------------------------
# Reads the FULL header + up to 20000 data rows, prints one archetype id.
# Classification only steers which trained model is tried first; every part
# still has the model->csv->serial fallback, so a wrong guess costs ratio, not
# correctness. Set VCFZL_CLASSIFY_DEBUG=1 to print the reasoning to stderr.
# Subshell + `set +e +o pipefail` so a closed pipe (awk exiting early) can't
# trip the caller's `set -e`.
classify_vcf() (
  set +e +o pipefail
  vcf="$1"
  # gzip magic 1f 8b -> decompress (covers .gz, .bgz, and mis-named bgzip files);
  # otherwise read as plain text.
  if [ "$(od -An -tx1 -N2 "$vcf" 2>/dev/null | tr -d ' \n')" = "1f8b" ]; then
    reader() { gzip -dc "$vcf"; }
  else
    reader() { cat "$vcf"; }
  fi
  reader 2>/dev/null | awk -F'\t' -v dbg="${VCFZL_CLASSIFY_DEBUG:-0}" '
    # ---- header ----
    /^##ALT=<ID=NON_REF/                                  { gvcf_hdr=1; next }
    /^##(SomaticSeq|tumor_sample|normal_sample)/          { som_hdr=1; next }
    /^##SAMPLE=<ID=(TUMOR|NORMAL|tumou?r|normal)/          { som_hdr=1; next }
    /^##source=.*([Mm]utect|[Ss]trelka|SomaticSniper|[Vv]arScan|Lancet|[Ss]omatic)/ { som_hdr=1; next }
    /^##GATKCommandLine.*HaplotypeCaller.*-ERC|--emit-ref-confidence/ { gvcf_hdr=1; next }
    /^##INFO=<ID=/ {
      k=$0; sub(/^##INFO=<ID=/,"",k); sub(/[,>].*/,"",k); info_def[k]=1; info_defs++; next }
    /^#CHROM/ {
      ncol=NF; has_format=($9=="FORMAT")
      for (i=10;i<=NF;i++){ s=tolower($i); if (s ~ /tum(o|ou)r|_t$|-t$|cancer/) tn++; if (s ~ /normal|_n$|-n$|blood|germline/) tn++ }
      next }
    /^#/ { next }
    # ---- data rows (cap for speed) ----
    { rows++
      if (rows>20000) exit
      if ($5 ~ /<NON_REF>/) nonref++
      if ($8 ~ /(^|;)SOMATIC(;|=|$)/) som_info++
      if ($8 ~ /(^|;)END=/) endinfo++
      # sample distinct INFO keys actually used, and look for annotation keys
      n=split($8,a,";")
      for (i=1;i<=n;i++){ key=a[i]; sub(/=.*/,"",key); used[key]=1 }
      if ($8 ~ /(^|;)(CLNSIG|CLNDN|CLNREVSTAT|ANN=|CSQ=|GENEINFO|COSMIC|BCSQ=|LOF=|NMD=)/) anno++
      if ($8 ~ /(^|;)(AF|AC|AN|MAF|AF_[a-z]+|gnomAD|AC_[a-z]+|1000[Gg]|dbSNP|TOPMED|KGP)/) freq++
    }
    END {
      if (ncol=="" || rows==0) { print "unknown"; exit }
      nsamp = has_format ? ncol-9 : 0
      nused=0; for (k in used) nused++
      reason = sprintf("ncol=%d nsamp=%d rows=%d nonref=%d end=%d som_info=%d som_hdr=%d gvcf_hdr=%d tn=%d info_defs=%d info_used=%d anno=%d freq=%d",
                       ncol,nsamp,rows,nonref,endinfo,som_info,som_hdr,gvcf_hdr,tn,info_defs,nused,anno,freq)
      # gVCF: explicit header, or a large fraction of rows are ref blocks
      if (gvcf_hdr || nonref > rows*0.1 || (endinfo > rows*0.5 && nsamp>=1)) cls="gvcf"
      # Somatic: header evidence, or SOMATIC INFO on many rows, or a
      # tumor/normal sample pair naming.
      else if (som_hdr || som_info > rows*0.2 || (nsamp==2 && tn>=2)) cls="somatic"
      # Sites-only (no genotypes)
      else if (!has_format || nsamp<=0) {
        if (anno > rows*0.05 || anno > freq) cls="sites-annotated"
        else                                cls="sites-frequency"
      }
      else if (nsamp==1)    cls="single-sample"
      else if (nsamp<=20)   cls="family-trio"
      else if (nsamp<1000)  cls="cohort"
      else                  cls="panel"
      if (dbg=="1") printf("classify: %s  [%s]\n", cls, reason) > "/dev/stderr"
      print cls
    }'
)

cmd_classify() {
  [ $# -eq 1 ] || die "usage: vcfzl classify <in.vcf>"
  [ -f "$1" ] || die "no such file: $1"
  local guess; guess="$(classify_vcf "$1")"
  echo "$guess"
  [ "$guess" = unknown ] && exit 1
  echo "  -> $(registry_desc "$guess")" >&2
}

# ---- compress ----------------------------------------------------------
cmd_compress() {
  local archetype="" threads="${SLURM_CPUS_PER_TASK:-8}" verify=0
  local -a pos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --archetype) archetype="${2:-}"; shift 2;;
      --threads)   threads="${2:-}"; shift 2;;
      --verify)    verify=1; shift;;
      -h|--help)   die "usage: vcfzl compress --archetype <id> [--threads N] [--verify] <in.vcf> <out.vcfz>";;
      -*)          die "unknown flag: $1";;
      *)           pos+=("$1"); shift;;
    esac
  done
  [ "${#pos[@]}" -eq 2 ] || die "usage: vcfzl compress [--archetype <id>|auto] [--threads N] [--verify] <in.vcf> <out.vcfz>"
  local in="${pos[0]}" out="${pos[1]}"
  [ -f "$in" ] || die "no such file: $in"

  # auto-detect: no --archetype, or --archetype auto
  if [ -z "$archetype" ] || [ "$archetype" = auto ]; then
    local guess; guess="$(classify_vcf "$in" || true)"
    [ -n "$guess" ] && [ "$guess" != unknown ] \
      || die "could not auto-detect archetype for $in — pass --archetype <id> explicitly (vcfzl archetypes)"
    archetype="$guess"
    echo "vcfzl: auto-detected archetype: $archetype" >&2
  fi

  registry_ids | grep -qx "$archetype" || die "unknown archetype '$archetype'. Run 'vcfzl archetypes'."
  local model; model="$(model_path "$archetype")"
  [ -f "$model" ] || die "archetype '$archetype' has no trained model at $model.
Train the library first:  scripts/vcf/train_vcf_library.sh"

  if [ "$verify" = 1 ]; then
    local guess; guess="$(classify_vcf "$in" || true)"
    if [ -n "$guess" ] && [ "$guess" != "$archetype" ] && [ "$guess" != unknown ]; then
      echo "vcfzl: WARNING: using --archetype $archetype but the file looks like '$guess'" >&2
    fi
  fi

  local stage; stage="$(mktemp -d "${TMPDIR:-/tmp}/vcfzl.XXXXXX")"
  trap 'rm -rf "$stage"' EXIT

  # Preprocess into parts of ~>= 16 MB. vcf_preprocessing makes max(threads,
  # size/maxchunk) parts, so a big thread count on a small VCF produces tiny
  # fragments that a trained OpenZL graph can reject. Bound the part count here.
  local insz pp; insz=$(stat -c%s "$in")
  pp=$(( insz / (16*1000*1000) )); [ "$pp" -lt 1 ] && pp=1
  [ "$pp" -gt "$threads" ] && pp="$threads"
  echo "vcfzl: preprocessing ($archetype, $pp split / $threads threads)..." >&2
  "$VCF_PRE" "$in" "$stage" --threads "$pp" --max-chunk-mib "$MAX_CHUNK_MIB" --force >/dev/null 2>&1 \
    || die "vcf_preprocessing failed on $in"
  printf '%s\n' "$archetype" > "$stage/archetype"

  echo "vcfzl: compressing body parts with $(basename "$model")..." >&2
  mkdir -p "$stage/zl"
  # Compress every part with the archetype model. A trained OpenZL graph can
  # hard-fail on a part whose structure differs from what it was trained on, so
  # fall back per-part: model -> csv(tab) -> serial. .zl parts are self-describing
  # so a mixed archive still decompresses. fb = count of parts that fell back.
  # Genotype symbol coding: a FORMAT=GT sample block is ~99% of a genotype-dense
  # body and uses only a handful of distinct calls, so map each to one byte
  # (row-major -- a transpose measures WORSE on sparse panels). vcf_gtcodec
  # falls back to a verbatim passthrough container for anything it cannot code,
  # so this is always reversible.
  local part b out_zl fb=0
  for part in "$stage"/body_parts/*.vcfbody; do
    [ -f "$part" ] || continue
    b="$(basename "$part")"; out_zl="$stage/zl/$b.zl"
    # VCFZL_GT=1 enables genotype symbol coding. OFF by default: measured on the
    # full archetype set it LOSES (family-trio -38%, cohort -29%, panel -6%),
    # because `--profile csv` already splits each row into per-sample column
    # streams -- an implicit transpose -- and a monolithic byte matrix throws
    # that structure away. Kept behind a flag for future experiments.
    local src="$part"
    if [ "${VCFZL_GT:-0}" = 1 ]; then
      "$VCF_GT" pack "$part" "$part.vgt" >/dev/null 2>&1 && src="$part.vgt"
    fi
    if   "$ZLI" compress "$src" --compressor "$model" --output "$out_zl" --force >/dev/null 2>&1; then :
    elif "$ZLI" compress "$src" --profile csv --profile-arg $'\t' --output "$out_zl" --force >/dev/null 2>&1; then fb=$((fb+1))
    elif "$ZLI" compress "$src" --profile serial --output "$out_zl" --force >/dev/null 2>&1; then fb=$((fb+1))
    else die "OpenZL compression failed on $b (all fallbacks exhausted)"
    fi
    rm -f "$part.vgt"
  done
  [ "$fb" -gt 0 ] && echo "vcfzl: note: $fb part(s) used a generic fallback codec (model mismatch)" >&2
  printf '%s\n' "$fb" > "$stage/fallback_parts"

  local nparts nzl
  nparts=$(find "$stage/body_parts" -name '*.vcfbody' | wc -l)
  nzl=$(find "$stage/zl" -name '*.zl' 2>/dev/null | wc -l)
  [ "$nzl" -ge "$nparts" ] || die "only $nzl/$nparts parts compressed — aborting"

  printf '%s\n' "$VCFZ_VERSION" > "$stage/FORMAT"
  _checksum "$stage" > "$stage/checksum"
  tar -C "$stage" -czf "$out" FORMAT checksum manifest.json archetype fallback_parts header.vcf zl
  trap - EXIT; rm -rf "$stage"

  if [ "$verify" = 1 ]; then
    local vt; vt="$(mktemp -d "${TMPDIR:-/tmp}/vcfzl.XXXXXX")"
    _vcfz_extract "$out" "$vt/rt.vcf" "$threads"
    cmp -s "$in" "$vt/rt.vcf" || { rm -rf "$vt"; rm -f "$out"; die "--verify FAILED: round trip is NOT byte-exact"; }
    rm -rf "$vt"
    echo "vcfzl: --verify OK (byte-exact round trip confirmed)" >&2
  fi

  local isz osz
  isz=$(stat -c%s "$in"); osz=$(stat -c%s "$out")
  awk -v i="$isz" -v o="$osz" -v a="$archetype" 'BEGIN{
    printf "vcfzl: %s  %.1f MB -> %.1f MB  (%.2fx, archetype=%s)\n", "done", i/1e6, o/1e6, i/o, a }' >&2
}

# ---- decompress ------------------------------------------------------
cmd_decompress() {
  local threads="${SLURM_CPUS_PER_TASK:-8}"
  local -a pos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --threads) threads="${2:-}"; shift 2;;
      -h|--help) die "usage: vcfzl decompress [--threads N] <in.vcfz> <out.vcf>";;
      -*)        die "unknown flag: $1";;
      *)         pos+=("$1"); shift;;
    esac
  done
  [ "${#pos[@]}" -eq 2 ] || die "usage: vcfzl decompress [--threads N] <in.vcfz> <out.vcf>"
  local in="${pos[0]}" out="${pos[1]}"
  [ -f "$in" ] || die "no such file: $in"

  echo "vcfzl: decompressing ($threads threads)..." >&2
  _vcfz_extract "$in" "$out" "$threads"
  echo "vcfzl: wrote $out ($(stat -c%s "$out") bytes, archetype=${VCFZ_ARCHETYPE:-?})" >&2
}

# ---- inspect --------------------------------------------------------
cmd_inspect() {
  [ $# -eq 1 ] || die "usage: vcfzl inspect <in.vcfz>"
  [ -f "$1" ] || die "no such file: $1"
  local archetype parts
  archetype="$(tar -xzOf "$1" archetype 2>/dev/null || echo '?')"
  parts="$(tar -tzf "$1" 2>/dev/null | grep -c '\.zl$' || true)"
  echo "archive:   $1 ($(stat -c%s "$1") bytes)"
  echo "archetype: $archetype  ($(registry_desc "$archetype"))"
  echo "zl parts:  $parts"
}

# ---- main ----------------------------------------------------------
[ $# -ge 1 ] || { sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1; }
sub="$1"; shift
case "$sub" in
  archetypes)  cmd_archetypes "$@";;
  classify)    require_tools; cmd_classify "$@";;
  compress)    require_tools; cmd_compress "$@";;
  decompress)  require_tools; cmd_decompress "$@";;
  inspect)     cmd_inspect "$@";;
  -h|--help)   sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//';;
  *)           die "unknown command '$sub' (try: archetypes classify compress decompress inspect)";;
esac
